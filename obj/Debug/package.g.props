<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <PackageJsonName Condition="$(PackageJsonName) == ''">@hanami/platform-data</PackageJsonName>
    <PackageJsonVersion Condition="$(PackageJsonVersion) == ''">0.1.0</PackageJsonVersion>
    <PackageJsonPrivate Condition="$(PackageJsonPrivate) == ''">true</PackageJsonPrivate>
    <PackageJsonType Condition="$(PackageJsonType) == ''">module</PackageJsonType>
    <PackageJsonScriptsGenerate Condition="$(PackageJsonScriptsGenerate) == ''">drizzle-kit generate</PackageJsonScriptsGenerate>
    <PackageJsonScriptsMigrate Condition="$(PackageJsonScriptsMigrate) == ''">drizzle-kit migrate</PackageJsonScriptsMigrate>
    <PackageJsonScriptsStudio Condition="$(PackageJsonScriptsStudio) == ''">drizzle-kit studio</PackageJsonScriptsStudio>
    <PackageJsonScriptsLint Condition="$(PackageJsonScriptsLint) == ''">eslint .</PackageJsonScriptsLint>
    <PackageJsonScriptsFormat Condition="$(PackageJsonScriptsFormat) == ''">prettier --write .</PackageJsonScriptsFormat>
    <PackageJsonDependenciesDotenv Condition="$(PackageJsonDependenciesDotenv) == ''">^17.4.2</PackageJsonDependenciesDotenv>
    <PackageJsonDependenciesDrizzleOrm Condition="$(PackageJsonDependenciesDrizzleOrm) == ''">^0.44.0</PackageJsonDependenciesDrizzleOrm>
    <PackageJsonDependenciesPostgres Condition="$(PackageJsonDependenciesPostgres) == ''">^3.4.7</PackageJsonDependenciesPostgres>
    <PackageJsonDependenciesPostgresql Condition="$(PackageJsonDependenciesPostgresql) == ''">^0.0.1</PackageJsonDependenciesPostgresql>
    <PackageJsonDevdependenciesEslintJs Condition="$(PackageJsonDevdependenciesEslintJs) == ''">^10.0.1</PackageJsonDevdependenciesEslintJs>
    <PackageJsonDevdependenciesTypesNode Condition="$(PackageJsonDevdependenciesTypesNode) == ''">^26.1.2</PackageJsonDevdependenciesTypesNode>
    <PackageJsonDevdependenciesDrizzleKit Condition="$(PackageJsonDevdependenciesDrizzleKit) == ''">^0.31.0</PackageJsonDevdependenciesDrizzleKit>
    <PackageJsonDevdependenciesEslint Condition="$(PackageJsonDevdependenciesEslint) == ''">^10.8.0</PackageJsonDevdependenciesEslint>
    <PackageJsonDevdependenciesPrettier Condition="$(PackageJsonDevdependenciesPrettier) == ''">^3.9.6</PackageJsonDevdependenciesPrettier>
    <PackageJsonDevdependenciesTsx Condition="$(PackageJsonDevdependenciesTsx) == ''">^4.23.9</PackageJsonDevdependenciesTsx>
    <PackageJsonDevdependenciesTypescript Condition="$(PackageJsonDevdependenciesTypescript) == ''">^5.9.0</PackageJsonDevdependenciesTypescript>
    <PackageJsonDevdependenciesTypescriptEslint Condition="$(PackageJsonDevdependenciesTypescriptEslint) == ''">^8.66.0</PackageJsonDevdependenciesTypescriptEslint>
  </PropertyGroup>
</Project>